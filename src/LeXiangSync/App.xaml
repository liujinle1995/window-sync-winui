<Application
    x:Class="LeXiangSync.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                把系统强调色改成本应用的蓝。
                ────────────────────────────────────────────────────────────
                WinUI 默认控件的强调色来自系统（用户可能设成绿色 / 紫色），
                复选框、开关、进度条、下拉框选中项都会跟着变，和设计稿的蓝对不上。
                这些 Color 资源必须在 XamlControlsResources 之后覆盖才生效；
                只覆盖 SystemAccentColor* 一整套（含 Light/Dark 派生），
                因为默认样式在不同状态下分别引用它们。
            -->
            <Color x:Key="SystemAccentColor">#FF4A9EFF</Color>
            <Color x:Key="SystemAccentColorLight1">#FF6FB3FF</Color>
            <Color x:Key="SystemAccentColorLight2">#FF8FC7FF</Color>
            <Color x:Key="SystemAccentColorLight3">#FFAFD8FF</Color>
            <Color x:Key="SystemAccentColorDark1">#FF3A8AE8</Color>
            <Color x:Key="SystemAccentColorDark2">#FF2E72CC</Color>
            <Color x:Key="SystemAccentColorDark3">#FF235AA8</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
