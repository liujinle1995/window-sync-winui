<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:LeXiangSync.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Styles/ChipToggleTemplate.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/SegmentToggleTemplate.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/AccentChipToggleTemplate.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/SyncChipToggleTemplate.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        设计令牌（Design Tokens）
        ────────────────────────────────────────────────────────────────
        全部按「深色 / 浅色」双套定义在 ThemeDictionaries 里，页面一律用
        {ThemeResource Lx...} 取，不写死颜色 —— 否则切主题时颜色不会跟着变
        （Window 级 RequestedTheme 覆盖不到 Application 级资源查找）。
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="LxWindowBgBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="LxSurfaceBrush" Color="#232323" />
            <SolidColorBrush x:Key="LxSurfaceAltBrush" Color="#1D1D1D" />
            <SolidColorBrush x:Key="LxSurfaceRaisedBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="LxStrokeBrush" Color="#353535" />
            <SolidColorBrush x:Key="LxStrokeSubtleBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="LxRowHoverBrush" Color="#2C2C2C" />
            <SolidColorBrush x:Key="LxNavSelectedBrush" Color="#2E2E2E" />

            <SolidColorBrush x:Key="LxAccentBrush" Color="#4A9EFF" />
            <SolidColorBrush x:Key="LxAccentHoverBrush" Color="#6FB3FF" />
            <SolidColorBrush x:Key="LxAccentSoftBrush" Color="#16324D" />

            <SolidColorBrush x:Key="LxSuccessBrush" Color="#3FB950" />
            <SolidColorBrush x:Key="LxSuccessSoftBrush" Color="#12331C" />
            <SolidColorBrush x:Key="LxWarningBrush" Color="#D29922" />
            <SolidColorBrush x:Key="LxWarningSoftBrush" Color="#332A10" />
            <SolidColorBrush x:Key="LxDangerBrush" Color="#F85149" />
            <SolidColorBrush x:Key="LxDangerSoftBrush" Color="#3A1717" />

            <SolidColorBrush x:Key="LxTextPrimaryBrush" Color="#F2F2F2" />
            <SolidColorBrush x:Key="LxTextSecondaryBrush" Color="#9B9B9B" />
            <SolidColorBrush x:Key="LxTextTertiaryBrush" Color="#767676" />

            <!--
                主窗口标签用红、从窗口标签用浅蓝：靠色相区分主从，不靠色块。
                主窗口这一处原先是暖金（#E0C07A），和行底色 LxMasterSoftBrush 同为暖色，
                凑在一起反而糊成一片；改成红之后「源」这个身份一眼就能挑出来。
            -->
            <SolidColorBrush x:Key="LxMasterBrush" Color="#FF7B72" />
            <SolidColorBrush x:Key="LxMasterSoftBrush" Color="#2E2A1C" />
            <SolidColorBrush x:Key="LxSlaveBrush" Color="#8FBEEB" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="LxWindowBgBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="LxSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="LxSurfaceAltBrush" Color="#FAFAFA" />
            <SolidColorBrush x:Key="LxSurfaceRaisedBrush" Color="#F0F0F0" />
            <SolidColorBrush x:Key="LxStrokeBrush" Color="#E4E4E4" />
            <SolidColorBrush x:Key="LxStrokeSubtleBrush" Color="#EFEFEF" />
            <SolidColorBrush x:Key="LxRowHoverBrush" Color="#F2F4F7" />
            <SolidColorBrush x:Key="LxNavSelectedBrush" Color="#EBEBEB" />

            <SolidColorBrush x:Key="LxAccentBrush" Color="#0F6CBD" />
            <SolidColorBrush x:Key="LxAccentHoverBrush" Color="#115EA3" />
            <SolidColorBrush x:Key="LxAccentSoftBrush" Color="#E8F1FB" />

            <SolidColorBrush x:Key="LxSuccessBrush" Color="#1A7F37" />
            <SolidColorBrush x:Key="LxSuccessSoftBrush" Color="#E6F4EA" />
            <SolidColorBrush x:Key="LxWarningBrush" Color="#9A6700" />
            <SolidColorBrush x:Key="LxWarningSoftBrush" Color="#FFF8E5" />
            <SolidColorBrush x:Key="LxDangerBrush" Color="#CF222E" />
            <SolidColorBrush x:Key="LxDangerSoftBrush" Color="#FFEBE9" />

            <SolidColorBrush x:Key="LxTextPrimaryBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="LxTextSecondaryBrush" Color="#666666" />
            <SolidColorBrush x:Key="LxTextTertiaryBrush" Color="#8A8A8A" />

            <SolidColorBrush x:Key="LxMasterBrush" Color="#CF222E" />
            <SolidColorBrush x:Key="LxMasterSoftBrush" Color="#FBF6E6" />
            <SolidColorBrush x:Key="LxSlaveBrush" Color="#1F6FB2" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 全局转换器 -->
    <converters:NullToBoolConverter x:Key="NullToBool" />
    <converters:InverseBoolConverter x:Key="InverseBool" />
    <converters:BoolToSeverityConverter x:Key="BoolToSeverity" />
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <converters:BoolStateTextConverter x:Key="BoolStateText" />
    <converters:BoolStateBrushConverter x:Key="BoolStateBrush" />
    <converters:LogLevelBrushConverter x:Key="LogLevelBrush" />

    <!-- 本地字体：取代原 Web 版远程加载的 Google Fonts，零网络依赖 -->
    <FontFamily x:Key="AppFontFamily">Segoe UI, Microsoft YaHei UI, Microsoft JhengHei UI</FontFamily>
    <FontFamily x:Key="NumericFontFamily">Cascadia Mono, Consolas, Segoe UI</FontFamily>

    <!-- ── 尺寸令牌 ──────────────────────────────────────────────────────── -->
    <x:Double x:Key="CardMinHeight">96</x:Double>
    <x:Double x:Key="LogPanelHeight">150</x:Double>
    <x:Double x:Key="LxCardRadius">8</x:Double>

    <Thickness x:Key="PagePadding">24,4,24,16</Thickness>
    <Thickness x:Key="LxCardPadding">13,11</Thickness>
    <Thickness x:Key="LxBottomBarPadding">16,8</Thickness>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="LxCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="LxSmallCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="LxPillCornerRadius">999</CornerRadius>

    <!-- ── 字阶 ──────────────────────────────────────────────────────────── -->
    <x:Double x:Key="LxFontTitle">22</x:Double>
    <x:Double x:Key="LxFontSection">14</x:Double>
    <x:Double x:Key="LxFontCardValue">16</x:Double>
    <x:Double x:Key="LxFontBody">13</x:Double>
    <x:Double x:Key="LxFontCaption">11.5</x:Double>
    <x:Double x:Key="LxFontMicro">10.5</x:Double>

    <!-- 主从窗口配色 -->
    <SolidColorBrush x:Key="MasterAccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="SlaveAccentBrush" Color="#10B981" />

    <!-- ══ 页面根容器 ══════════════════════════════════════════════════════ -->
    <Style x:Key="PageRootStyle" TargetType="Grid">
        <Setter Property="Padding" Value="{StaticResource PagePadding}" />
    </Style>

    <!-- ══ 卡片 ════════════════════════════════════════════════════════════ -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LxSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LxStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource LxCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource LxCardPadding}" />
    </Style>

    <!-- 卡片内部再分块（如「一键流程进度」里的进度条 + 日志区） -->
    <Style x:Key="LxInsetPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LxSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LxStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource LxSmallCornerRadius}" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- ══ 字阶样式 ════════════════════════════════════════════════════════ -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource LxFontTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource LxTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource LxFontCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource LxTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource LxFontSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource LxTextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- 卡片内的小标题：不占独立行，通常与右侧操作并排 -->
    <Style x:Key="LxCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource LxFontSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource LxTextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CardCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource LxFontCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource LxTextSecondaryBrush}" />
    </Style>

    <Style x:Key="CardValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource LxFontCardValue}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource LxTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource LxFontCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource LxTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 设计稿里大量出现的小号次要说明（卡片副标题、表格底部提示） -->
    <Style x:Key="LxHintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}" />

    <Style x:Key="LxMetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource LxFontMicro}" />
        <Setter Property="Foreground" Value="{ThemeResource LxTextTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 数字 / 时间 / 坐标一律等宽，列对齐才不会跳动 -->
    <Style x:Key="LxMonoTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NumericFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource LxFontCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource LxTextSecondaryBrush}" />
    </Style>

    <Style x:Key="LxTableHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource LxFontCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource LxTextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ══ 胶囊徽章（主窗口 / 从窗口 N / 未加入 / 运行中 …） ══════════════ -->
    <Style x:Key="LxPillBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource LxPillCornerRadius}" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="LxPillTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource LxFontMicro}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ══ 底部工具条 ══════════════════════════════════════════════════════ -->
    <Style x:Key="LxBottomBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LxSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LxStrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="{StaticResource LxBottomBarPadding}" />
    </Style>

    <!-- ══ 表格列表 ════════════════════════════════════════════════════════ -->
    <!--
        WinUI 3 没有 DataGrid，表格用 ListView + 等宽列模拟。
        把 ListViewItem 的默认内边距压到 0 并让内容横向拉伸，
        行才能和表头对齐；圆角与悬停底色贴近设计稿的表格行观感。
    -->
    <Style x:Key="LxRowListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,1,0,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="LxTableListViewStyle" TargetType="ListView">
        <Setter Property="Padding" Value="0,0,0,4" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="IsItemClickEnabled" Value="False" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource LxRowListViewItemStyle}" />
        <Setter Property="ItemContainerTransitions">
            <Setter.Value>
                <TransitionCollection />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 进程树：行更紧凑 -->
    <Style x:Key="LxTreeListViewStyle" TargetType="ListView" BasedOn="{StaticResource LxTableListViewStyle}">
        <Setter Property="Padding" Value="0,2,0,2" />
    </Style>

    <!-- 表头行：与行模板用同一套列宽 -->
    <Style x:Key="LxTableHeaderBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LxSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LxStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- ══ 按钮变体 ════════════════════════════════════════════════════════ -->
    <!-- 标题栏 / 卡片右上角的无边框图标按钮 -->
    <Style x:Key="LxIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- 表格里的文字链接操作（加载 / 覆盖更新 / 删除） -->
    <Style x:Key="LxLinkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource LxFontCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource LxAccentBrush}" />
    </Style>

    <Style x:Key="LxDangerLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource LxLinkButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource LxDangerBrush}" />
    </Style>

    <!-- 次要按钮：描边、无强填充 -->
    <Style x:Key="LxSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource LxSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LxStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="{StaticResource LxFontCaption}" />
    </Style>

    <Style x:Key="LxPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource LxSecondaryButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource LxAccentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LxAccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style x:Key="LxStopButtonStyle" TargetType="Button" BasedOn="{StaticResource LxSecondaryButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource LxDangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LxDangerBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource LxDangerBrush}" />
    </Style>

    <!--
        ToggleButton 必须有自己的 TargetType 样式：WinUI 不允许把 TargetType=Button 的
        Style 套到 ToggleButton 上，运行期会抛 XamlParseException（编译期查不出来）。
        视觉上与次要按钮保持一致。
    -->
    <Style x:Key="LxToggleChipStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource LxSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LxStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource LxFontCaption}" />
    </Style>

    <!-- 分段控件外壳（一段的选中视觉见文件末尾的 LxSegmentToggleStyle） -->
    <Style x:Key="LxSegmentHostStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LxSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LxStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="2" />
    </Style>

    <!-- ══ 状态点 ══════════════════════════════════════════════════════════ -->
    <Style x:Key="LxStatusDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ══ 导航栏 ══════════════════════════════════════════════════════════ -->
    <!--
        设计稿的导航项是「左侧 3px 强调色竖条 + 圆角 6 的选中胶囊」，
        NavigationView 自带的选择视觉（方角 + 整条高亮）对不上，因此外壳改成手写导航。
        这两套样式只负责静态观感，选中态由 MainWindow 的 SelectNavigation 切换。
    -->
    <Style x:Key="LxNavPillStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="5,0,0,0" />
    </Style>

    <Style x:Key="LxNavTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource LxFontBody}" />
        <Setter Property="Foreground" Value="{ThemeResource LxTextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ══ 表格行分隔线 ════════════════════════════════════════════════════ -->
    <!--
        行模板根用它包一层：1px 底边画分隔线。直接给 Grid 加 Border 是做不到的，
        所以统一用 Border 当行容器。
    -->
    <Style x:Key="LxTableRowBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource LxStrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- 表格底部提示行（右侧窗口表里那行「已选 1 主 / 4 从 · …」） -->
    <Style x:Key="LxTableFooterStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource LxStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- ══ 底部条上的同步项开关（◉ 鼠标 / ◉ 键盘 …） ═══════════════════════ -->
    <!--
        设计稿是一个胶囊，里面是「小圆点 + 文字」；开启时圆点为强调色实心，
        关闭时是空心描边圆圈。ToggleSwitch 的轨道观感和它差得远，所以自绘模板。
    -->
    <Style x:Key="LxSyncChipToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource LxSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LxStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource LxFontCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource LxTextSecondaryBrush}" />
        <Setter Property="Template" Value="{StaticResource LxSyncChipTemplate}" />
    </Style>

    <!-- ══ 分段控件的选中态 ════════════════════════════════════════════════ -->
    <!-- 设计稿选中段是强调色实心 + 白字，默认 ToggleButton 视觉给的是灰底，必须自绘 -->
    <Style x:Key="LxSegmentToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource LxFontCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource LxTextSecondaryBrush}" />
        <Setter Property="Template" Value="{StaticResource LxSegmentTemplate}" />
    </Style>

    <!-- ══ 设置项行（左标签 / 右控件） ══════════════════════════════════════ -->
    <Style x:Key="LxSettingLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource LxFontCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource LxTextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="LxSettingValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource LxFontCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource LxTextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="LxSettingRowStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource LxStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,4" />
    </Style>

    <Style x:Key="LxSettingRowLastStyle" TargetType="Border" BasedOn="{StaticResource LxSettingRowStyle}">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ══ 大号统计数值（左侧「从窗口数」） ═════════════════════════════════ -->
    <Style x:Key="LxStatValueLargeStyle" TargetType="TextBlock" BasedOn="{StaticResource CardValueStyle}">
        <Setter Property="FontSize" Value="20" />
    </Style>

    <!-- ══ 迷你条（折叠态） ════════════════════════════════════════════════ -->
    <!--
        设计稿的迷你窗口是一根「独立浮起的长条」：1px 描边 + 圆角，
        左侧徽标 +「乐享同步 · 迷你」，右侧「置顶 / 同步 / 仅排版 / 还原 / 最小化 / 关闭」。
        它没有系统标题栏按钮，所以折叠时要把窗口边框与标题栏一起关掉。
    -->
    <Style x:Key="LxCompactBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LxSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LxStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="LxCompactChipStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource LxSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LxStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="{StaticResource LxFontCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource LxTextPrimaryBrush}" />
        <Setter Property="Template" Value="{StaticResource LxAccentChipTemplate}" />
    </Style>

    <!--
        迷你条的启停按钮。两种状态：待启动 = 普通背景色（与「置顶」同档，不抢视线），
        同步中 = 强调蓝实心 + 白字。颜色与文字色都由模板的 Checked / Unchecked 决定
        （见 SyncChipToggleTemplate.xaml），这里只放未选中时的基础值。
    -->
    <Style x:Key="LxCompactSyncStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource LxSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LxStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="{StaticResource LxFontCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource LxTextPrimaryBrush}" />
        <Setter Property="Template" Value="{StaticResource LxSyncChipTemplate}" />
    </Style>
</ResourceDictionary>
