<Window
    x:Class="LeXiangSync.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LeXiangSync.Models">

    <Grid x:Name="RootGrid" Background="{ThemeResource LxWindowBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            自定义标题栏：窗口内容延伸到标题栏区域（ExtendsContentIntoTitleBar）。
            左半部分是拖拽区（代码里按实际宽度 SetDragRectangles），右侧按钮区不参与拖拽，
            否则点击会被窗口拖动吃掉。系统的最小化 / 最大化 / 关闭由 AppWindow 绘制，
            这里只需给它们让出 RightInset 宽度（代码里算）。
        -->
        <Grid
            x:Name="AppTitleBar"
            Height="44"
            Padding="14,0,0,0"
            SizeChanged="OnTitleBarSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                x:Name="DragRegion"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <!-- 应用徽标：圆角方块 + 强调色同步图标 -->
                <Border
                    Width="20"
                    Height="20"
                    Background="{ThemeResource LxAccentBrush}"
                    CornerRadius="5">
                    <FontIcon
                        FontSize="11"
                        Foreground="White"
                        Glyph="&#xE895;" />
                </Border>

                <TextBlock
                    x:Name="TitleText"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource LxTextPrimaryBrush}"
                    Text="乐享同步" />

                <!-- 版本号：设计稿里是紧随标题的浅灰小字，没有胶囊底 -->
                <TextBlock
                    x:Name="VersionText"
                    VerticalAlignment="Center"
                    FontSize="10.5"
                    Foreground="{ThemeResource LxTextTertiaryBrush}"
                    Text="{x:Bind ViewModel.VersionText, Mode=OneWay}" />
            </StackPanel>

            <StackPanel
                x:Name="TitleBarButtons"
                Grid.Column="1"
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="2">

                <Button
                    x:Name="SearchButton"
                    AutomationProperties.Name="搜索进程或窗口"
                    Click="OnSearchClick"
                    Style="{StaticResource LxIconButtonStyle}"
                    ToolTipService.ToolTip="到「同步」页筛选进程与窗口">
                    <FontIcon FontSize="13" Glyph="&#xE721;" />
                </Button>

                <Button
                    x:Name="CompactToggleButton"
                    AutomationProperties.Name="缩小为迷你窗口"
                    Click="OnCompactClick"
                    Style="{StaticResource LxIconButtonStyle}"
                    ToolTipService.ToolTip="缩小为迷你窗口（只留同步与还原）">
                    <FontIcon FontSize="13" Glyph="&#xE73F;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 主体：左侧导航 + 内容区 -->
        <Grid x:Name="BodyGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="168" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                手写导航。设计稿的选中态是「最左 3px 强调色竖条 + 圆角 6 的淡底胶囊 + 白字」，
                NavigationView 自带的选择视觉（方角、整条高亮、缩进 40px）对不上，所以弃用它。

                选中 / 悬停底色用预置的 Border 叠层做（只切 Visibility，不碰颜色），
                前景色则从 NavPalette 里的探针元素取当前主题画刷 —— 直接读
                Application.Resources 里的主题资源在切主题后会拿到旧实例，探针由
                {ThemeResource} 自动刷新，代码每次读它就行。
            -->
            <StackPanel
                x:Name="NavRail"
                Padding="0,6,0,0"
                Spacing="2">

                <!-- 主题画刷探针：不参与布局、不可见、不可命中 -->
                <Grid
                    x:Name="NavPalette"
                    Width="0"
                    Height="0"
                    IsHitTestVisible="False"
                    Opacity="0">
                    <Rectangle x:Name="PalettePrimary" Fill="{ThemeResource LxTextPrimaryBrush}" />
                    <Rectangle x:Name="PaletteSecondary" Fill="{ThemeResource LxTextSecondaryBrush}" />
                </Grid>

                <Grid
                    x:Name="NavItemSetup"
                    Height="38"
                    Background="Transparent"
                    PointerEntered="OnNavPointerEntered"
                    PointerExited="OnNavPointerExited"
                    Tag="setup"
                    Tapped="OnNavTapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="NavBarSetup"
                        Width="3"
                        Height="18"
                        VerticalAlignment="Center"
                        Background="{ThemeResource LxAccentBrush}"
                        CornerRadius="2"
                        Visibility="Collapsed" />
                    <Grid
                        Grid.Column="1"
                        Margin="5,0,10,0">
                        <Border
                            x:Name="NavSelSetup"
                            Background="{ThemeResource LxNavSelectedBrush}"
                            CornerRadius="6"
                            Visibility="Collapsed" />
                        <Border
                            x:Name="NavHoverSetup"
                            Background="{ThemeResource LxRowHoverBrush}"
                            CornerRadius="6"
                            Visibility="Collapsed" />
                        <StackPanel
                            Padding="10,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <FontIcon
                                x:Name="NavIconSetup"
                                FontSize="15"
                                Foreground="{ThemeResource LxTextSecondaryBrush}"
                                Glyph="&#xE895;" />
                            <TextBlock
                                x:Name="NavTextSetup"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{ThemeResource LxTextSecondaryBrush}"
                                Text="同步" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid
                    x:Name="NavItemLaunch"
                    Height="38"
                    Background="Transparent"
                    PointerEntered="OnNavPointerEntered"
                    PointerExited="OnNavPointerExited"
                    Tag="launch"
                    Tapped="OnNavTapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="NavBarLaunch"
                        Width="3"
                        Height="18"
                        VerticalAlignment="Center"
                        Background="{ThemeResource LxAccentBrush}"
                        CornerRadius="2"
                        Visibility="Collapsed" />
                    <Grid
                        Grid.Column="1"
                        Margin="5,0,10,0">
                        <Border
                            x:Name="NavSelLaunch"
                            Background="{ThemeResource LxNavSelectedBrush}"
                            CornerRadius="6"
                            Visibility="Collapsed" />
                        <Border
                            x:Name="NavHoverLaunch"
                            Background="{ThemeResource LxRowHoverBrush}"
                            CornerRadius="6"
                            Visibility="Collapsed" />
                        <StackPanel
                            Padding="10,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <FontIcon
                                x:Name="NavIconLaunch"
                                FontSize="15"
                                Foreground="{ThemeResource LxTextSecondaryBrush}"
                                Glyph="&#xE71D;" />
                            <TextBlock
                                x:Name="NavTextLaunch"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{ThemeResource LxTextSecondaryBrush}"
                                Text="多开启动" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid
                    x:Name="NavItemPlans"
                    Height="38"
                    Background="Transparent"
                    PointerEntered="OnNavPointerEntered"
                    PointerExited="OnNavPointerExited"
                    Tag="plans"
                    Tapped="OnNavTapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="NavBarPlans"
                        Width="3"
                        Height="18"
                        VerticalAlignment="Center"
                        Background="{ThemeResource LxAccentBrush}"
                        CornerRadius="2"
                        Visibility="Collapsed" />
                    <Grid
                        Grid.Column="1"
                        Margin="5,0,10,0">
                        <Border
                            x:Name="NavSelPlans"
                            Background="{ThemeResource LxNavSelectedBrush}"
                            CornerRadius="6"
                            Visibility="Collapsed" />
                        <Border
                            x:Name="NavHoverPlans"
                            Background="{ThemeResource LxRowHoverBrush}"
                            CornerRadius="6"
                            Visibility="Collapsed" />
                        <StackPanel
                            Padding="10,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <FontIcon
                                x:Name="NavIconPlans"
                                FontSize="15"
                                Foreground="{ThemeResource LxTextSecondaryBrush}"
                                Glyph="&#xE8A5;" />
                            <TextBlock
                                x:Name="NavTextPlans"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{ThemeResource LxTextSecondaryBrush}"
                                Text="方案" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid
                    x:Name="NavItemSettings"
                    Height="38"
                    Background="Transparent"
                    PointerEntered="OnNavPointerEntered"
                    PointerExited="OnNavPointerExited"
                    Tag="settings"
                    Tapped="OnNavTapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="NavBarSettings"
                        Width="3"
                        Height="18"
                        VerticalAlignment="Center"
                        Background="{ThemeResource LxAccentBrush}"
                        CornerRadius="2"
                        Visibility="Collapsed" />
                    <Grid
                        Grid.Column="1"
                        Margin="5,0,10,0">
                        <Border
                            x:Name="NavSelSettings"
                            Background="{ThemeResource LxNavSelectedBrush}"
                            CornerRadius="6"
                            Visibility="Collapsed" />
                        <Border
                            x:Name="NavHoverSettings"
                            Background="{ThemeResource LxRowHoverBrush}"
                            CornerRadius="6"
                            Visibility="Collapsed" />
                        <StackPanel
                            Padding="10,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <FontIcon
                                x:Name="NavIconSettings"
                                FontSize="15"
                                Foreground="{ThemeResource LxTextSecondaryBrush}"
                                Glyph="&#xE713;" />
                            <TextBlock
                                x:Name="NavTextSettings"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{ThemeResource LxTextSecondaryBrush}"
                                Text="设置" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </StackPanel>

            <Frame x:Name="ContentFrame" Grid.Column="1">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </Grid>

        <!-- 环形运行日志：由各页底部的「运行日志 N/300」展开 -->
        <Border
            x:Name="LogPanelBorder"
            Grid.Row="2"
            Height="{x:Bind ViewModel.LogPanelHeight, Mode=OneWay}"
            Background="{ThemeResource LxSurfaceAltBrush}"
            BorderBrush="{ThemeResource LxStrokeBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{x:Bind ViewModel.LogExpanded, Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="16,6,16,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            Style="{StaticResource LxTableHeaderTextStyle}"
                            Text="运行日志" />
                        <TextBlock
                            Style="{StaticResource LxMetaTextStyle}"
                            Text="保留最近 300 条 · 警告黄色 · 错误红色" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Button
                            Command="{x:Bind ViewModel.ClearLogsCommand}"
                            Content="清空"
                            Style="{StaticResource LxLinkButtonStyle}" />
                        <Button
                            Click="OnCollapseLogClick"
                            Content="收起"
                            Style="{StaticResource LxLinkButtonStyle}" />
                    </StackPanel>
                </Grid>

                <ListView
                    x:Name="LogList"
                    Grid.Row="1"
                    Padding="10,0"
                    ItemsSource="{x:Bind ViewModel.Logs.Entries, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="6,1" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:LogEntry">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource NumericFontFamily}"
                                    FontSize="11"
                                    Foreground="{ThemeResource LxTextTertiaryBrush}"
                                    Text="{x:Bind TimeText}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="12"
                                    Foreground="{x:Bind LevelBrush}"
                                    Text="{x:Bind Message}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
        <!--
            ══ 迷你窗口（折叠态） ══════════════════════════════════════════════
            设计稿里它不是「缩小版的标题栏」，而是一根独立浮起的长条：
            1px 描边 + 圆角，左侧徽标 +「乐享同步 · 迷你」，右侧「置顶 / 同步 / 还原」，
            **没有系统标题栏按钮**。所以折叠时把窗口边框与标题栏一起关掉（见 ApplyCompactChrome），
            整条自身就是拖拽区（按钮除外）。
        -->
        <Border
            x:Name="CompactBar"
            Grid.RowSpan="3"
            Style="{StaticResource LxCompactBarStyle}"
            DoubleTapped="OnCompactDoubleTapped"
            PointerPressed="OnCompactDragStart"
            PointerMoved="OnCompactDragMove"
            PointerReleased="OnCompactDragEnd"
            PointerCaptureLost="OnCompactDragEnd"
            Visibility="Collapsed">
            <!--
                两列都用 Auto：长条的宽度由窗口尺寸决定（见 MeasureCompactWidth），
                内容宽度不受挤压，所以这里不能再留 * 列 —— 否则窗口比内容宽出来的那一段
                会全部堆在文字和按钮之间，就是「中间那段空白」。
            -->
            <Grid
                x:Name="CompactBarContent"
                Padding="10,0"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="7">
                    <Border
                        Width="16"
                        Height="16"
                        Background="{ThemeResource LxAccentBrush}"
                        CornerRadius="8">
                        <FontIcon
                            FontSize="9"
                            Foreground="White"
                            Glyph="&#xE895;" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource LxTextSecondaryBrush}"
                        Text="乐享同步 · 迷你" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <ToggleButton
                        x:Name="CompactTopmostToggle"
                        Click="OnCompactTopmostClick"
                        Style="{StaticResource LxCompactChipStyle}"
                        ToolTipService.ToolTip="让迷你条始终显示在其他窗口之上">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon
                                FontSize="9"
                                Foreground="{ThemeResource LxAccentBrush}"
                                Glyph="&#xE74A;" />
                            <TextBlock FontSize="11.5" Text="置顶" />
                        </StackPanel>
                    </ToggleButton>

                    <!--
                        启停：用 ToggleButton 而不是 Button。Button 点了以后只有文字在
                        「开始同步 / 停止同步」之间跳，颜色恒定，条上根本看不出现在开没开。
                        IsChecked 跟随引擎真实状态：待启动 = 普通背景色，同步中 = 蓝实心，
                        见 LxSyncChipTemplate。

                        内容用纯字符串而不是内嵌 TextBlock：文字色要随状态切换（蓝底白字 /
                        浅底主文字色），只有交给 ContentPresenter 才吃得下模板里的 Foreground。
                    -->
                    <ToggleButton
                        x:Name="CompactSyncToggle"
                        Click="OnCompactSyncClick"
                        Content="{x:Bind ViewModel.ToggleButtonText, Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.IsActive, Mode=OneWay}"
                        Style="{StaticResource LxCompactSyncStyle}"
                        ToolTipService.ToolTip="开始 / 停止同步（快捷键 Ctrl + Alt + S）" />

                    <!--
                        仅排版：等同于启动页的「仅排布窗口」——按当前组的排版基准把已经
                        开着的窗口重新摆一遍，不启动任何进程。放在条上是为了多开时不必
                        先把完整界面还原回来；忙碌时（启动 / 排版中）由代码禁用。
                    -->
                    <Button
                        x:Name="CompactArrangeButton"
                        Height="30"
                        Padding="12,0"
                        Click="OnCompactArrangeClick"
                        Style="{StaticResource LxSecondaryButtonStyle}"
                        ToolTipService.ToolTip="只重新摆放已打开的窗口，不启动进程（不还原完整界面）">
                        <TextBlock
                            x:Name="CompactArrangeText"
                            FontSize="11.5"
                            Text="仅排版" />
                    </Button>

                    <Button
                        Height="30"
                        Padding="12,0"
                        Click="OnRestoreClick"
                        Content="还原"
                        FontSize="11.5"
                        Style="{StaticResource LxSecondaryButtonStyle}"
                        ToolTipService.ToolTip="恢复完整窗口" />

                    <!-- 系统按钮：折叠后没有标题栏，最小化 / 关闭只能由长条自己提供 -->
                    <Button
                        Width="30"
                        Height="30"
                        AutomationProperties.Name="最小化"
                        Click="OnCompactMinimizeClick"
                        Style="{StaticResource LxIconButtonStyle}"
                        ToolTipService.ToolTip="最小化到任务栏">
                        <FontIcon FontSize="11" Glyph="&#xE921;" />
                    </Button>

                    <Button
                        Width="30"
                        Height="30"
                        AutomationProperties.Name="关闭"
                        Click="OnCompactCloseClick"
                        Style="{StaticResource LxIconButtonStyle}"
                        ToolTipService.ToolTip="关闭（若开启了「关闭时最小化到托盘」则收进托盘）">
                        <FontIcon FontSize="11" Glyph="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
