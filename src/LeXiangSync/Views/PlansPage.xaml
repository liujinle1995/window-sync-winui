<Page
    x:Class="LeXiangSync.Views.PlansPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LeXiangSync.Models">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ 页头 ══════════════════════════════════════════════════════ -->
        <Grid Padding="24,12,24,10" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="方案" />
                <TextBlock
                    Style="{StaticResource PageSubtitleStyle}"
                    Text="用「窗口标题 + 进程名 + 同标题序号」指纹保存主从关系，目标程序重启后仍可还原" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Command="{x:Bind ViewModel.ImportCommand}"
                    Style="{StaticResource LxSecondaryButtonStyle}"
                    ToolTipService.ToolTip="从 JSON 文件导入方案（追加到现有列表）">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon FontSize="10" Glyph="&#xE896;" />
                        <TextBlock FontSize="11.5" Text="导入 JSON" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{x:Bind ViewModel.ExportCommand}"
                    Style="{StaticResource LxSecondaryButtonStyle}"
                    ToolTipService.ToolTip="把当前全部方案导出为 JSON 文件">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon FontSize="10" Glyph="&#xE898;" />
                        <TextBlock FontSize="11.5" Text="导出 JSON" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══ 提示条：通栏、冷色底、1px 描边 ══════════════════════════════ -->
        <Border
            Grid.Row="1"
            Margin="24,0,24,10"
            Padding="10,6"
            Background="{ThemeResource LxAccentSoftBrush}"
            BorderBrush="{ThemeResource LxStrokeBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="7">
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource LxAccentBrush}"
                    Glyph="&#xE946;" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource LxHintTextStyle}"
                    Text="{x:Bind ViewModel.AutoLoadHint, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <!-- ══ 已保存方案 ══════════════════════════════════════════════════ -->
        <Border
            Grid.Row="2"
            Margin="24,0"
            Padding="0"
            Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 卡片标题行 -->
                <Grid Padding="14,10,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock Style="{StaticResource LxCardTitleStyle}" Text="已保存方案" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource CardCaptionStyle}"
                            Text="{x:Bind ViewModel.PlanCountText, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Command="{x:Bind ViewModel.CreateFromCurrentCommand}"
                        Style="{StaticResource LxSecondaryButtonStyle}"
                        ToolTipService.ToolTip="把「同步」页当前的主从选择另存为一份新方案">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon FontSize="10" Glyph="&#xE710;" />
                            <TextBlock FontSize="11.5" Text="用当前选择新建" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 表头：列宽权重必须与行模板完全一致（21 / 25 / 10 / 19 / 25） -->
                <Border
                    Grid.Row="1"
                    Style="{StaticResource LxTableHeaderBorderStyle}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="21*" />
                            <ColumnDefinition Width="25*" />
                            <ColumnDefinition Width="10*" />
                            <ColumnDefinition Width="19*" />
                            <ColumnDefinition Width="25*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource LxTableHeaderTextStyle}" Text="方案" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource LxTableHeaderTextStyle}"
                            Text="主窗口指纹" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource LxTableHeaderTextStyle}"
                            Text="从窗口" />
                        <TextBlock
                            Grid.Column="3"
                            Style="{StaticResource LxTableHeaderTextStyle}"
                            Text="同步项" />
                        <TextBlock
                            Grid.Column="4"
                            Style="{StaticResource LxTableHeaderTextStyle}"
                            Text="操作" />
                    </Grid>
                </Border>

                <ListView
                    Grid.Row="2"
                    HorizontalContentAlignment="Stretch"
                    IsItemClickEnabled="False"
                    ItemsSource="{x:Bind ViewModel.Plans, Mode=OneWay}"
                    SelectionMode="None"
                    Style="{StaticResource LxTableListViewStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SyncPlan">
                            <Border
                                MinHeight="58"
                                Style="{StaticResource LxTableRowBorderStyle}"
                                Tapped="OnRowTapped">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="21*" />
                                        <ColumnDefinition Width="25*" />
                                        <ColumnDefinition Width="10*" />
                                        <ColumnDefinition Width="19*" />
                                        <ColumnDefinition Width="25*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 生效行整行淡底，垫在内容最底层 -->
                                    <Border
                                        Grid.ColumnSpan="5"
                                        Background="{ThemeResource LxAccentSoftBrush}"
                                        CornerRadius="4"
                                        Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                                    <Grid
                                        Grid.ColumnSpan="5"
                                        Padding="10,9"
                                        ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="21*" />
                                            <ColumnDefinition Width="25*" />
                                            <ColumnDefinition Width="10*" />
                                            <ColumnDefinition Width="19*" />
                                            <ColumnDefinition Width="25*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 方案：名称 + 状态小字（纯文字，不用胶囊） -->
                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Spacing="1">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource LxTextPrimaryBrush}"
                                                Text="{x:Bind Name, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Style="{StaticResource LxMetaTextStyle}"
                                                Text="{x:Bind StatusLineText, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="11.5"
                                            Foreground="{ThemeResource LxTextSecondaryBrush}"
                                            Text="{x:Bind MasterFingerprintText}"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="11.5"
                                            Foreground="{ThemeResource LxTextSecondaryBrush}"
                                            Text="{x:Bind SlaveCountText}"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            FontSize="11.5"
                                            Foreground="{ThemeResource LxTextSecondaryBrush}"
                                            Text="{x:Bind SyncItemsText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />

                                        <!-- 操作：四个蓝色文字链接，· 分隔 -->
                                        <StackPanel
                                            Grid.Column="4"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <Button
                                                Click="OnRowActionClick"
                                                Content="加载"
                                                Style="{StaticResource LxLinkButtonStyle}"
                                                Tag="load"
                                                ToolTipService.ToolTip="把这份方案套用到当前同步" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11.5"
                                                Foreground="{ThemeResource LxTextTertiaryBrush}"
                                                Text=" · " />
                                            <Button
                                                Click="OnRowActionClick"
                                                Content="覆盖更新"
                                                Style="{StaticResource LxLinkButtonStyle}"
                                                Tag="update"
                                                ToolTipService.ToolTip="用「同步」页当前的主从选择覆盖这份方案" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11.5"
                                                Foreground="{ThemeResource LxTextTertiaryBrush}"
                                                Text=" · " />
                                            <Button
                                                Click="OnRowActionClick"
                                                Content="重命名"
                                                Style="{StaticResource LxLinkButtonStyle}"
                                                Tag="rename" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11.5"
                                                Foreground="{ThemeResource LxTextTertiaryBrush}"
                                                Text=" · " />
                                            <Button
                                                Click="OnRowActionClick"
                                                Content="删除"
                                                Style="{StaticResource LxLinkButtonStyle}"
                                                Tag="delete"
                                                ToolTipService.ToolTip="删除这份方案（不可撤销）" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- ══ 底部常驻栏 ══════════════════════════════════════════════════ -->
        <Border
            Grid.Row="3"
            Margin="0,10,0,0"
            Style="{StaticResource LxBottomBarStyle}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Command="{x:Bind ViewModel.LoadCommand}"
                    CommandParameter="{x:Bind ViewModel.Selected, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.Selected, Mode=OneWay, Converter={StaticResource NullToBool}}"
                    Style="{StaticResource LxPrimaryButtonStyle}"
                    ToolTipService.ToolTip="把所选方案套用到当前同步">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon FontSize="10" Glyph="&#xE896;" />
                        <TextBlock FontSize="11.5" Text="加载所选方案" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.UpdateCommand}"
                    CommandParameter="{x:Bind ViewModel.Selected, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.Selected, Mode=OneWay, Converter={StaticResource NullToBool}}"
                    Style="{StaticResource LxSecondaryButtonStyle}"
                    ToolTipService.ToolTip="用「同步」页当前的主从选择覆盖所选方案">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon FontSize="10" Glyph="&#xE72C;" />
                        <TextBlock FontSize="11.5" Text="用当前选择覆盖" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.DeleteCommand}"
                    CommandParameter="{x:Bind ViewModel.Selected, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.Selected, Mode=OneWay, Converter={StaticResource NullToBool}}"
                    Style="{StaticResource LxSecondaryButtonStyle}"
                    ToolTipService.ToolTip="删除所选方案（不可撤销）">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon
                            FontSize="10"
                            Foreground="{ThemeResource LxDangerBrush}"
                            Glyph="&#xE74D;" />
                        <TextBlock FontSize="11.5" Text="删除方案" />
                    </StackPanel>
                </Button>

                <TextBlock
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    Foreground="{ThemeResource LxTextSecondaryBrush}"
                    Text="{x:Bind ViewModel.SelectedSummary, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>
