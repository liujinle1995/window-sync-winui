<Page
    x:Class="LeXiangSync.Views.LaunchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LeXiangSync.Models"
    xmlns:viewmodels="using:LeXiangSync.ViewModels">

    <Page.Resources>
        <!--
            本页专用样式：只在这里定义，不动 AppStyles.xaml。
        -->

        <!-- 分组标签条的一个 tab：透明底、无边框，视觉全交给模板里的文字 + 下划线 -->
        <Style x:Key="LxTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <!-- 数值行右对齐的等宽数字 -->
        <Style x:Key="LxMonoValueStyle" TargetType="TextBlock" BasedOn="{StaticResource LxMonoTextStyle}">
            <Setter Property="Foreground" Value="{ThemeResource LxTextPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 日志区里的行：去掉 ListViewItem 默认的 12px 内边距 -->
        <Style x:Key="LxLogItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── 页头 ─────────────────────────────────────────────────────── -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="多开启动" />
                <TextBlock
                    Style="{StaticResource PageSubtitleStyle}"
                    Text="向 Sandboxie 沙箱批量拉起客户端，自动进游戏并按预设排布" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="8">
                <Button AutomationProperties.Name="新建组" Command="{x:Bind ViewModel.AddGroupCommand}" Style="{StaticResource LxSecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="11" Glyph="&#xE710;" />
                        <TextBlock Text="新建组" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="删除组" Command="{x:Bind ViewModel.RemoveGroupCommand}" Style="{StaticResource LxSecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            FontSize="11"
                            Foreground="{ThemeResource LxDangerBrush}"
                            Glyph="&#xE74D;" />
                        <TextBlock Text="删除组" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── 分组标签条：当前项白字 + 2px 强调色下划线 ─────────────────── -->
        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource CardCaptionStyle}"
                Text="当前组" />

            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:GroupTab">
                        <Button
                            AutomationProperties.Name="{x:Bind Label}"
                            Command="{x:Bind SelectCommand, Mode=OneWay}"
                            CommandParameter="{x:Bind}"
                            Style="{StaticResource LxTabButtonStyle}">
                            <Grid MinHeight="34" Padding="8,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="2" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource LxFontBody}"
                                    Foreground="{ThemeResource LxTextPrimaryBrush}"
                                    Text="{x:Bind Label}"
                                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource LxFontBody}"
                                    Foreground="{ThemeResource LxTextSecondaryBrush}"
                                    Text="{x:Bind Label}"
                                    Visibility="{x:Bind IsUnselected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <Border
                                    Grid.Row="1"
                                    Height="2"
                                    Background="{ThemeResource LxAccentBrush}"
                                    Visibility="{x:Bind UnderlineVisibility, Mode=OneWay}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- ── 内容区 ───────────────────────────────────────────────────── -->
        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

                <!-- 卡片一：沙箱配置 -->
                <Border Padding="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Padding="14,12,14,10" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Style="{StaticResource LxCardTitleStyle}" Text="沙箱配置" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LxHintTextStyle}"
                                Text="逐沙箱设置窗口落位与三个按钮的相对坐标" />

                            <Button
                                Grid.Column="2"
                                AutomationProperties.Name="补启缺失沙箱"
                                Command="{x:Bind ViewModel.StartMissingCommand}"
                                Style="{StaticResource LxSecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="11" Glyph="&#xE72C;" />
                                    <TextBlock Text="补启缺失沙箱" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="3"
                                AutomationProperties.Name="一键关闭本组"
                                Command="{x:Bind ViewModel.CloseGroupCommand}"
                                Style="{StaticResource LxSecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon
                                        FontSize="11"
                                        Foreground="{ThemeResource LxDangerBrush}"
                                        Glyph="&#xE7E8;" />
                                    <TextBlock Text="一键关闭本组" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 表头：列宽与行模板必须完全一致，否则对不齐 -->
                        <Border
                            Height="32"
                            Padding="10,0"
                            Style="{StaticResource LxTableHeaderBorderStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Style="{StaticResource LxTableHeaderTextStyle}" Text="沙箱" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource LxTableHeaderTextStyle}"
                                    Text="落位" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource LxTableHeaderTextStyle}"
                                    Text="开始游戏 / 进入游戏 / 登录游戏（相对坐标）" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource LxTableHeaderTextStyle}"
                                    Text="状态" />
                                <TextBlock
                                    Grid.Column="4"
                                    Style="{StaticResource LxTableHeaderTextStyle}"
                                    Text="操作" />
                            </Grid>
                        </Border>

                        <ListView
                            ItemsSource="{x:Bind ViewModel.VisibleAccounts, Mode=OneWay}"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            SelectionMode="None"
                            Style="{StaticResource LxTableListViewStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:GameAccount">
                                    <Border BorderBrush="{ThemeResource LxStrokeSubtleBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <!-- 启动失败的行整行淡红底 -->
                                            <Border Background="{ThemeResource LxDangerSoftBrush}" Visibility="{x:Bind IsFailedStatus, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                                            <Grid
                                                Height="44"
                                                Padding="10,0"
                                                ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource LxFontBody}"
                                                Foreground="{ThemeResource LxTextPrimaryBrush}"
                                                Text="{x:Bind Name, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource CardCaptionStyle}"
                                                Text="{x:Bind SlotText, Mode=OneWay}" />

                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource LxMonoTextStyle}"
                                                Text="{x:Bind PointText, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />

                                            <Grid
                                                Grid.Column="3"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="{StaticResource LxFontCaption}"
                                                    Foreground="{ThemeResource LxSuccessBrush}"
                                                    Text="{x:Bind StatusText, Mode=OneWay}"
                                                    Visibility="{x:Bind IsRunningStatus, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock
                                                    FontSize="{StaticResource LxFontCaption}"
                                                    Foreground="{ThemeResource LxDangerBrush}"
                                                    Text="{x:Bind StatusText, Mode=OneWay}"
                                                    Visibility="{x:Bind IsFailedStatus, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock
                                                    FontSize="{StaticResource LxFontCaption}"
                                                    Foreground="{ThemeResource LxTextTertiaryBrush}"
                                                    Text="{x:Bind StatusText, Mode=OneWay}"
                                                    Visibility="{x:Bind IsIdleStatus, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>

                                            <StackPanel
                                                Grid.Column="4"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="2">
                                                <Button
                                                    Command="{x:Bind FocusCommand, Mode=OneWay}"
                                                    CommandParameter="{x:Bind}"
                                                    Content="聚焦"
                                                    IsEnabled="{x:Bind IsFocusEnabled, Mode=OneWay}"
                                                    Style="{StaticResource LxLinkButtonStyle}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource LxMetaTextStyle}"
                                                    Text="·" />
                                                <Button
                                                    Command="{x:Bind StartCommand, Mode=OneWay}"
                                                    CommandParameter="{x:Bind}"
                                                    Content="{x:Bind ActionText, Mode=OneWay}"
                                                    Style="{StaticResource LxLinkButtonStyle}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource LxMetaTextStyle}"
                                                    Text="·" />
                                                <Button
                                                    Command="{x:Bind CloseCommand, Mode=OneWay}"
                                                    CommandParameter="{x:Bind}"
                                                    Content="关闭"
                                                    Style="{StaticResource LxLinkButtonStyle}" />
                                            </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- 卡片二 / 卡片三：各占一半 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 卡片二：时序参数与屏幕基准 -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource LxCardTitleStyle}" Text="时序参数与屏幕基准" />

                            <StackPanel Margin="0,4,0,0">
                                <Border
                                    Padding="0,7"
                                    BorderBrush="{ThemeResource LxStrokeSubtleBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CardCaptionStyle}"
                                            Text="逐个拉起间隔" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource LxMonoValueStyle}"
                                            Text="{x:Bind ViewModel.LaunchIntervalText, Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <Border
                                    Padding="0,7"
                                    BorderBrush="{ThemeResource LxStrokeSubtleBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CardCaptionStyle}"
                                            Text="等待窗口超时" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource LxMonoValueStyle}"
                                            Text="{x:Bind ViewModel.LauncherWaitText, Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <Border
                                    Padding="0,7"
                                    BorderBrush="{ThemeResource LxStrokeSubtleBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CardCaptionStyle}"
                                            Text="点击后延时" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource LxMonoValueStyle}"
                                            Text="{x:Bind ViewModel.ClickDelayText, Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <Border Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CardCaptionStyle}"
                                            Text="屏幕基准尺寸" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource LxMonoValueStyle}"
                                            Text="{x:Bind ViewModel.ScreenSizeText, Mode=OneWay}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 卡片三：一键流程进度 -->
                    <Border
                        Grid.Column="1"
                        Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource LxCardTitleStyle}" Text="一键流程进度" />

                            <!--
                                WinUI 默认的 ProgressBar 轨道只有 2px，和设计稿的 5px 圆角条差得远，
                                模板又改不动（不允许动 AppStyles），所以这里用两个 Border 自己画：
                                宽度在 code-behind 里按百分比算，值变了就重算。
                            -->
                            <Border
                                x:Name="ProgressTrack"
                                Height="5"
                                Margin="0,2,0,0"
                                Background="{ThemeResource LxStrokeBrush}"
                                CornerRadius="3"
                                SizeChanged="OnProgressTrackSizeChanged">
                                <Border
                                    x:Name="ProgressFill"
                                    Width="0"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource LxAccentBrush}"
                                    CornerRadius="3" />
                            </Border>

                            <TextBlock
                                Style="{StaticResource LxMonoTextStyle}"
                                Text="{x:Bind ViewModel.ProgressSummary, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />

                            <Border Style="{StaticResource LxInsetPanelStyle}">
                                <ListView
                                    x:Name="ProgressList"
                                    Height="92"
                                    Background="Transparent"
                                    ItemContainerStyle="{StaticResource LxLogItemStyle}"
                                    ItemsSource="{x:Bind ViewModel.Progress, Mode=OneWay}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock
                                                FontFamily="{StaticResource NumericFontFamily}"
                                                FontSize="{StaticResource LxFontMicro}"
                                                Foreground="{ThemeResource LxTextSecondaryBrush}"
                                                Text="{x:Bind}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 详细参数：设计稿里没有，收起来放，避免编辑能力丢失 -->
                <StackPanel Spacing="12">
                        <Button
                            HorizontalAlignment="Left"
                            Command="{x:Bind ViewModel.ToggleDetailsCommand}"
                            Content="{x:Bind ViewModel.DetailsToggleText, Mode=OneWay}"
                            Style="{StaticResource LxLinkButtonStyle}" />

                        <Grid
                            ColumnSpacing="12"
                            RowSpacing="12"
                            Visibility="{x:Bind ViewModel.IsDetailsOpen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 程序路径 -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource LxCardTitleStyle}" Text="程序路径" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Header="Sandboxie Start.exe"
                                        IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                                        PlaceholderText="C:\Program Files\Sandboxie-Plus\Start.exe"
                                        Text="{x:Bind ViewModel.SandboxiePath, Mode=TwoWay}" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="0,24,0,0"
                                        VerticalAlignment="Bottom"
                                        Command="{x:Bind ViewModel.BrowseCommand}"
                                        CommandParameter="sandboxie"
                                        Content="浏览…" />
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Header="游戏启动器"
                                        IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                                        PlaceholderText="MyPCLauncher_x64r.exe"
                                        Text="{x:Bind ViewModel.LauncherPath, Mode=TwoWay}" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="0,24,0,0"
                                        VerticalAlignment="Bottom"
                                        Command="{x:Bind ViewModel.BrowseCommand}"
                                        CommandParameter="launcher"
                                        Content="浏览…" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 屏幕参数 -->
                        <Border
                            Grid.Column="1"
                            Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource LxCardTitleStyle}" Text="屏幕参数" />
                                <TextBlock Style="{StaticResource LxHintTextStyle}" Text="排版按这里填写的分辨率计算，多屏拼接时填总尺寸。" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <NumberBox
                                        Header="屏幕宽"
                                        IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                                        Maximum="16384"
                                        Minimum="640"
                                        Value="{x:Bind ViewModel.ScreenWidth, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Column="1"
                                        Header="屏幕高"
                                        IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                                        Maximum="16384"
                                        Minimum="480"
                                        Value="{x:Bind ViewModel.ScreenHeight, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Column="2"
                                        Header="任务栏高"
                                        IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                                        Maximum="300"
                                        Minimum="0"
                                        Value="{x:Bind ViewModel.TaskbarHeight, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Column="3"
                                        Header="基准沙箱"
                                        IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                                        PlaceholderText="fc"
                                        Text="{x:Bind ViewModel.ReferenceBox, Mode=TwoWay}"
                                        ToolTipService.ToolTip="以这个沙箱窗口的实际尺寸作为其他窗口排版时的统一尺寸" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 按钮坐标 -->
                        <Border
                            Grid.Row="1"
                            Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource LxCardTitleStyle}" Text="按钮相对坐标" />
                                <TextBlock Style="{StaticResource LxHintTextStyle}" Text="相对窗口宽高的比例，0.5 / 0.5 就是窗口正中。" />

                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Margin="0,24,0,0"
                                        VerticalAlignment="Center"
                                        Text="开始游戏" />
                                    <NumberBox
                                        Grid.Column="1"
                                        Header="横向"
                                        IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                                        Maximum="1"
                                        Minimum="0"
                                        SmallChange="0.01"
                                        Value="{x:Bind ViewModel.StartX, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Column="2"
                                        Header="纵向"
                                        IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                                        Maximum="1"
                                        Minimum="0"
                                        SmallChange="0.01"
                                        Value="{x:Bind ViewModel.StartY, Mode=TwoWay}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,24,0,0"
                                        VerticalAlignment="Center"
                                        Text="进入游戏" />
                                    <NumberBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Header="横向"
                                        IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                                        Maximum="1"
                                        Minimum="0"
                                        SmallChange="0.01"
                                        Value="{x:Bind ViewModel.EnterX, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Header="纵向"
                                        IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                                        Maximum="1"
                                        Minimum="0"
                                        SmallChange="0.01"
                                        Value="{x:Bind ViewModel.EnterY, Mode=TwoWay}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Margin="0,24,0,0"
                                        VerticalAlignment="Center"
                                        Text="登录游戏" />
                                    <NumberBox
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Header="横向"
                                        IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                                        Maximum="1"
                                        Minimum="0"
                                        SmallChange="0.01"
                                        Value="{x:Bind ViewModel.LoginX, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Header="纵向"
                                        IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                                        Maximum="1"
                                        Minimum="0"
                                        SmallChange="0.01"
                                        Value="{x:Bind ViewModel.LoginY, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 等待时间 -->
                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource LxCardTitleStyle}" Text="等待时间" />

                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <NumberBox
                                        Header="沙箱启动间隔（秒）"
                                        IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                                        Maximum="30"
                                        Minimum="1"
                                        Value="{x:Bind ViewModel.LaunchInterval, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Column="1"
                                        Header="等待启动器（秒）"
                                        IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                                        Maximum="600"
                                        Minimum="0"
                                        Value="{x:Bind ViewModel.LauncherWait, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Row="1"
                                        Header="点「开始游戏」后（秒）"
                                        IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                                        Maximum="120"
                                        Minimum="0"
                                        Value="{x:Bind ViewModel.StartDelay, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Header="等待游戏进程（秒）"
                                        IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                                        Maximum="600"
                                        Minimum="0"
                                        Value="{x:Bind ViewModel.GameWait, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Row="2"
                                        Header="点「进入游戏」后（秒）"
                                        IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                                        Maximum="120"
                                        Minimum="0"
                                        Value="{x:Bind ViewModel.EnterDelay, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Header="点「登录游戏」后（秒）"
                                        IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                                        Maximum="120"
                                        Minimum="0"
                                        Value="{x:Bind ViewModel.LoginDelay, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Row="3"
                                        Header="登录后稳定等待（秒）"
                                        IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                                        Maximum="300"
                                        Minimum="0"
                                        Value="{x:Bind ViewModel.Settle, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 沙箱与落位 -->
                        <Border
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource LxCardTitleStyle}" Text="沙箱与落位" />
                                <TextBlock Style="{StaticResource LxHintTextStyle}" Text="名字要与 Sandboxie 里的沙箱名一致，窗口标题中的 [xxx] 就是靠它认领的。" />

                                <ListView
                                    MaxHeight="220"
                                    IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.VisibleAccounts, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                                    SelectionMode="Single"
                                    Style="{StaticResource LxTableListViewStyle}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:GameAccount">
                                            <Grid Padding="6,4" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBox
                                                    PlaceholderText="沙箱名"
                                                    Text="{x:Bind Name, Mode=TwoWay}" />
                                                <ComboBox
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Stretch"
                                                    SelectedIndex="{x:Bind SlotIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="不排列" />
                                                    <ComboBoxItem Content="左上" />
                                                    <ComboBoxItem Content="左下" />
                                                    <ComboBoxItem Content="居中" />
                                                    <ComboBoxItem Content="右上" />
                                                    <ComboBoxItem Content="右下" />
                                                </ComboBox>
                                                <Button
                                                    Grid.Column="2"
                                                    Command="{x:Bind CloseCommand, Mode=OneWay}"
                                                    CommandParameter="{x:Bind}"
                                                    Content="关闭客户端"
                                                    Style="{StaticResource LxLinkButtonStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        PlaceholderText="新增沙箱名（加进当前组）"
                                        Text="{x:Bind ViewModel.NewBoxName, Mode=TwoWay}" />
                                    <Button
                                        Grid.Column="1"
                                        Command="{x:Bind ViewModel.AddBoxCommand}"
                                        Content="添加"
                                        Style="{StaticResource LxSecondaryButtonStyle}" />
                                    <Button
                                        Grid.Column="2"
                                        Command="{x:Bind ViewModel.RemoveBoxCommand}"
                                        CommandParameter="{x:Bind ViewModel.Selected, Mode=OneWay}"
                                        Content="移除"
                                        Style="{StaticResource LxSecondaryButtonStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ── 底部条 ───────────────────────────────────────────────────── -->
        <Border
            Grid.Row="3"
            Margin="-24,0,-24,-16"
            Style="{StaticResource LxBottomBarStyle}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button AutomationProperties.Name="一键启动本组" Command="{x:Bind ViewModel.RunCommand}" Style="{StaticResource LxPrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="11" Glyph="&#xE768;" />
                        <TextBlock Text="一键启动本组" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="仅排布窗口"
                    Command="{x:Bind ViewModel.ArrangeCommand}"
                    Style="{StaticResource LxSecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="11" Glyph="&#xE8A9;" />
                        <TextBlock Text="仅排布窗口" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="2"
                    AutomationProperties.Name="中断流程"
                    Command="{x:Bind ViewModel.CancelCommand}"
                    Style="{StaticResource LxStopButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="11" Glyph="&#xE71A;" />
                        <TextBlock Text="中断流程" />
                    </StackPanel>
                </Button>

                <TextBlock
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Style="{StaticResource LxMonoTextStyle}"
                    Text="{x:Bind ViewModel.LastRunText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasLastRun, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</Page>
