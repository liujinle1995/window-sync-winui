<Page
    x:Class="LeXiangSync.Views.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LeXiangSync.Models">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ 页头 ══════════════════════════════════════════════════════ -->
        <Grid Padding="24,12,24,10" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="同步" />
                <TextBlock
                    Style="{StaticResource PageSubtitleStyle}"
                    Text="把主窗口的鼠标、键盘与文本实时镜像到从窗口，全程不抢焦点" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">

                <!-- 主题分段控件 -->
                <Border Style="{StaticResource LxSegmentHostStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="1">
                        <ToggleButton
                            Click="OnThemeSystemClick"
                            Content="跟随系统"
                            IsChecked="{x:Bind Settings.IsThemeSystem, Mode=OneWay}"
                            Style="{StaticResource LxSegmentToggleStyle}" />
                        <ToggleButton
                            Click="OnThemeLightClick"
                            Content="浅色"
                            IsChecked="{x:Bind Settings.IsThemeLight, Mode=OneWay}"
                            Style="{StaticResource LxSegmentToggleStyle}" />
                        <ToggleButton
                            Click="OnThemeDarkClick"
                            Content="深色"
                            IsChecked="{x:Bind Settings.IsThemeDark, Mode=OneWay}"
                            Style="{StaticResource LxSegmentToggleStyle}" />
                    </StackPanel>
                </Border>

                <!-- 设计稿里开关在文字左侧，所以不用 ToggleSwitch 的 Content -->
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <ToggleSwitch
                        MinWidth="0"
                        IsOn="{x:Bind Status.IsPaused, Mode=TwoWay}"
                        OnContent=""
                        OffContent=""
                        ToolTipService.ToolTip="打开即暂停（等同于停止同步），关闭则开始同步" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource LxSettingLabelStyle}"
                        Text="暂停同步" />
                </StackPanel>

                <Button
                    Command="{x:Bind ViewModel.SavePlanCommand}"
                    Style="{StaticResource LxSecondaryButtonStyle}"
                    ToolTipService.ToolTip="把当前主窗口、从窗口与同步项存成方案（自动命名，可在「方案」页重命名）">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon FontSize="12" Glyph="&#xE74E;" />
                        <TextBlock FontSize="11.5" Text="保存方案" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══ 四张状态卡 ════════════════════════════════════════════════ -->
        <Grid
            Grid.Row="1"
            Padding="24,0,24,10"
            ColumnSpacing="11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 运行状态 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource CardCaptionStyle}" Text="运行状态" />
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Ellipse
                            Fill="{x:Bind Status.StatusBrush, Mode=OneWay}"
                            Style="{StaticResource LxStatusDotStyle}" />
                        <TextBlock
                            Style="{StaticResource CardValueStyle}"
                            Text="{x:Bind Status.StatusText, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource LxMetaTextStyle}"
                        Text="{x:Bind Status.StatusDetail, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- 主窗口 -->
            <Border
                Grid.Column="1"
                Style="{StaticResource CardStyle}">
                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource CardCaptionStyle}" Text="主窗口" />
                    <TextBlock
                        Style="{StaticResource CardValueStyle}"
                        Text="{x:Bind ViewModel.MasterSummary, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.MasterSummary, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource LxMetaTextStyle}"
                        Text="{x:Bind ViewModel.MasterFingerprint, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- 从窗口数 -->
            <Border
                Grid.Column="2"
                Style="{StaticResource CardStyle}">
                <StackPanel Spacing="3">
                    <TextBlock Style="{StaticResource CardCaptionStyle}" Text="从窗口数" />
                    <TextBlock
                        FontFamily="{StaticResource NumericFontFamily}"
                        Style="{StaticResource LxStatValueLargeStyle}"
                        Text="{x:Bind Status.SlaveCountText, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource LxMetaTextStyle}"
                        Text="{x:Bind Status.SlaveDetail, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- 同步项 -->
            <Border
                Grid.Column="3"
                Style="{StaticResource CardStyle}">
                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource CardCaptionStyle}" Text="同步项" />
                    <TextBlock
                        Style="{StaticResource CardValueStyle}"
                        Text="{x:Bind Status.SyncItemsCountText, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource LxMetaTextStyle}"
                        Text="{x:Bind Status.SyncItemsDetail, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ 进程与窗口 ════════════════════════════════════════════════ -->
        <Border
            Grid.Row="2"
            Margin="24,0"
            Padding="0"
            Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    卡片标题 + 工具栏同一行：设计稿把搜索框、自动刷新、刷新按钮
                    都放在「进程与窗口」这一行的右侧，而不是另起一行。
                -->
                <Grid
                    Padding="13,9,13,8"
                    ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock Style="{StaticResource LxCardTitleStyle}" Text="进程与窗口" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource LxMetaTextStyle}"
                            Text="按软件名分组 · 三态勾选 · 右键结束进程" />
                    </StackPanel>

                    <!-- 搜索框：放大镜画在框内左侧，TextBox 自己不留图标位 -->
                    <Grid
                        Grid.Column="2"
                        Width="190">
                        <TextBox
                            x:Name="FilterBox"
                            Height="28"
                            Padding="28,0,8,0"
                            PlaceholderText="按标题或进程名筛选"
                            Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource LxTextTertiaryBrush}"
                            Glyph="&#xE721;"
                            IsHitTestVisible="False"
                            Margin="9,0,0,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" />
                    </Grid>

                    <StackPanel
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <ToggleSwitch
                            MinWidth="0"
                            IsOn="{x:Bind IsAutoRefreshOn, Mode=TwoWay}"
                            OnContent=""
                            OffContent=""
                            ToolTipService.ToolTip="按 2 秒周期重新枚举进程；已选好窗口时会自动暂停" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource LxSettingLabelStyle}"
                            Text="自动刷新 2s" />
                    </StackPanel>

                    <Button
                        Grid.Column="4"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        Style="{StaticResource LxSecondaryButtonStyle}"
                        ToolTipService.ToolTip="重新枚举进程与可见窗口">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon FontSize="11" Glyph="&#xE72C;" />
                            <TextBlock FontSize="11.5" Text="刷新" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 左右两栏 -->
                <Grid
                    Grid.Row="1"
                    Padding="13,0,13,11"
                    ColumnSpacing="11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：进程树 -->
                    <Border
                        Background="{ThemeResource LxSurfaceAltBrush}"
                        BorderBrush="{ThemeResource LxStrokeSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource LxTableHeaderBorderStyle}">
                                <TextBlock Style="{StaticResource LxTableHeaderTextStyle}" Text="软件 / 进程实例" />
                            </Border>

                            <ListView
                                Grid.Row="1"
                                Padding="0,3,0,3"
                                IsItemClickEnabled="False"
                                ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                                SelectionMode="None"
                                Style="{StaticResource LxTreeListViewStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProcessGroupVm">
                                        <StackPanel>
                                            <!-- 软件分组行：箭头 + 三态勾选 + 「软件名 (实例数)」 -->
                                            <Grid
                                                Padding="4,2,8,2"
                                                ColumnSpacing="4"
                                                Visibility="{x:Bind IsFirstOfApp}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 展开时垫一层底色：设计稿靠这个区分「这组是展开的」 -->
                                                <Border
                                                    Grid.ColumnSpan="3"
                                                    Background="{ThemeResource LxSurfaceRaisedBrush}"
                                                    CornerRadius="4"
                                                    Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                                                <Button
                                                    Width="20"
                                                    Height="20"
                                                    Padding="0"
                                                    Click="OnGroupExpandClick"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource LxIconButtonStyle}"
                                                    ToolTipService.ToolTip="展开 / 收起该软件的进程实例">
                                                    <FontIcon
                                                        FontSize="10"
                                                        Foreground="{ThemeResource LxTextSecondaryBrush}"
                                                        Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" />
                                                </Button>

                                                <CheckBox
                                                    Grid.Column="1"
                                                    MinWidth="0"
                                                    Padding="0"
                                                    Click="OnGroupCheckClick"
                                                    IsChecked="{x:Bind SelectionState, Mode=OneWay}"
                                                    IsThreeState="True"
                                                    ToolTipService.ToolTip="整组一起加入 / 移出从窗口" />

                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource LxTextPrimaryBrush}"
                                                    Text="{x:Bind AppTitle, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>

                                            <!-- 进程实例行：勾选框与组行同一列，视觉上对齐 -->
                                            <Grid
                                                Padding="4,1,8,1"
                                                ColumnSpacing="4"
                                                Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox
                                                    Grid.Column="1"
                                                    MinWidth="0"
                                                    Padding="0"
                                                    Click="OnGroupCheckClick"
                                                    IsChecked="{x:Bind SelectionState, Mode=OneWay}"
                                                    IsThreeState="True"
                                                    ToolTipService.ToolTip="该进程的全部窗口一起加入 / 移出从窗口" />

                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource NumericFontFamily}"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource LxTextSecondaryBrush}"
                                                    Text="{x:Bind InstanceText}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- 右：窗口表 -->
                    <Border
                        Grid.Column="1"
                        Background="{ThemeResource LxSurfaceAltBrush}"
                        BorderBrush="{ThemeResource LxStrokeSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 表头：全选框 + 列名 -->
                            <Border Style="{StaticResource LxTableHeaderBorderStyle}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox
                                        MinWidth="0"
                                        Padding="0"
                                        Click="OnHeaderCheckClick"
                                        IsChecked="{x:Bind ViewModel.HeaderSelectionState, Mode=OneWay}"
                                        IsThreeState="True"
                                        ToolTipService.ToolTip="全选 / 清空当前列表" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource LxTableHeaderTextStyle}"
                                        Text="窗口标题" />
                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource LxTableHeaderTextStyle}"
                                        Text="角色" />
                                </Grid>
                            </Border>

                            <ListView
                                Grid.Row="1"
                                IsItemClickEnabled="False"
                                ItemsSource="{x:Bind ViewModel.Windows, Mode=OneWay}"
                                SelectionMode="None"
                                Style="{StaticResource LxTableListViewStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:WindowItem">
                                        <Border Style="{StaticResource LxTableRowBorderStyle}">
                                            <Grid
                                                Padding="10,6"
                                                Background="Transparent"
                                                ColumnSpacing="8"
                                                DoubleTapped="OnRowDoubleTapped"
                                                RightTapped="OnRowRightTapped"
                                                ToolTipService.ToolTip="双击一键聚焦 · 右键结束进程 / 设为主窗口">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="96" />
                                                </Grid.ColumnDefinitions>

                                                <Grid.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Click="OnRowSetMasterClick" Text="设为主窗口" />
                                                        <MenuFlyoutItem Click="OnRowToggleSyncClick" Text="加入 / 移出同步" />
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Click="OnRowFocusClick" Text="聚焦窗口" />
                                                        <MenuFlyoutItem Click="OnRowKillProcessClick" Text="结束进程" />
                                                    </MenuFlyout>
                                                </Grid.ContextFlyout>

                                                <!-- 主窗口行垫暖色底：设计稿用这一层把「源」标出来 -->
                                                <Border
                                                    Grid.ColumnSpan="3"
                                                    Background="{ThemeResource LxMasterSoftBrush}"
                                                    CornerRadius="4"
                                                    Visibility="{x:Bind IsMaster, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                                                <CheckBox
                                                    MinWidth="0"
                                                    Padding="0"
                                                    Click="OnRowCheckClick"
                                                    IsChecked="{x:Bind IsInSync, Mode=OneWay}"
                                                    ToolTipService.ToolTip="勾选即加入同步（主窗口不通过此框移出）" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{ThemeResource LxTextPrimaryBrush}"
                                                        Text="{x:Bind Title}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Style="{StaticResource LxMonoTextStyle}"
                                                        Text="{x:Bind Subtitle}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!--
                                                    角色列是纯文字（无底色），只靠颜色区分；
                                                    三段叠放而不是绑模型里的画刷 —— 模型画刷在切主题后不刷新。
                                                -->
                                                <Grid
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="11.5"
                                                        Foreground="{ThemeResource LxMasterBrush}"
                                                        Text="主窗口"
                                                        Visibility="{x:Bind IsMaster, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock
                                                        FontSize="11.5"
                                                        Foreground="{ThemeResource LxSlaveBrush}"
                                                        Text="{x:Bind SlaveRoleText, Mode=OneWay}"
                                                        Visibility="{x:Bind IsSlave, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock
                                                        FontSize="11.5"
                                                        Foreground="{ThemeResource LxTextTertiaryBrush}"
                                                        Text="未加入"
                                                        Visibility="{x:Bind IsNone, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- 表格底部提示：设计稿把它放在右表的底部，而不是整张卡的底部 -->
                            <Border
                                Grid.Row="2"
                                Style="{StaticResource LxTableFooterStyle}">
                                <TextBlock
                                    Style="{StaticResource LxMetaTextStyle}"
                                    Text="{x:Bind ViewModel.TableHint, Mode=OneWay}" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ══ 底部常驻栏 ══════════════════════════════════════════════════ -->
        <Border
            Grid.Row="3"
            Margin="0,10,0,0"
            Style="{StaticResource LxBottomBarStyle}">
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">
                <Grid MinWidth="780" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ToggleButton
                            Content="鼠标"
                            IsChecked="{x:Bind Main.Engine.SyncMouse, Mode=TwoWay}"
                            Style="{StaticResource LxSyncChipToggleStyle}" />
                        <ToggleButton
                            Content="键盘"
                            IsChecked="{x:Bind Main.Engine.SyncKeyboard, Mode=TwoWay}"
                            Style="{StaticResource LxSyncChipToggleStyle}" />
                        <ToggleButton
                            Content="剪贴板"
                            IsChecked="{x:Bind Main.Engine.SyncClipboard, Mode=TwoWay}"
                            Style="{StaticResource LxSyncChipToggleStyle}" />
                        <ToggleButton
                            Content="文本镜像"
                            IsChecked="{x:Bind Main.TextMirror, Mode=TwoWay}"
                            Style="{StaticResource LxSyncChipToggleStyle}"
                            ToolTipService.ToolTip="文本镜像：同步中文输入与粘贴内容。读主窗口输入框文本做 diff，再用 WM_CHAR 投递给从窗口" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            Command="{x:Bind Main.ToggleSyncCommand}"
                            Style="{StaticResource LxPrimaryButtonStyle}"
                            ToolTipService.ToolTip="快捷键 Ctrl + Alt + S">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="10" Glyph="&#xE71A;" />
                                <TextBlock FontSize="11.5" Text="{x:Bind Main.ToggleButtonText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>

                        <ToggleButton
                            IsChecked="{x:Bind Main.LogExpanded, Mode=TwoWay}"
                            Style="{StaticResource LxToggleChipStyle}"
                            ToolTipService.ToolTip="展开 / 收起运行日志">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="11" Glyph="&#xE8A9;" />
                                <TextBlock FontSize="11.5" Text="{x:Bind Main.LogCountText, Mode=OneWay}" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
