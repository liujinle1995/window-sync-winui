<Page
    x:Class="LeXiangSync.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ 页头 ══════════════════════════════════════════════════════ -->
        <Grid Padding="24,12,24,10" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="设置" />
                <TextBlock
                    Style="{StaticResource PageSubtitleStyle}"
                    Text="所有配置随改随存，保存在 %LOCALAPPDATA%\LeXiangSync" />
            </StackPanel>

            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.ResetDefaultsCommand}"
                Style="{StaticResource LxSecondaryButtonStyle}"
                ToolTipService.ToolTip="把外观与通用选项恢复为出厂默认值（不会删除方案）">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="11" Glyph="&#xE7A7;" />
                    <TextBlock FontSize="11.5" Text="恢复默认" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ══ 2 列 × 3 行卡片网格 ═══════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" Padding="24,0,24,8">
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ── 1 外观 ──────────────────────────────────────────── -->
                <Border Padding="12,9" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,1"
                            Style="{StaticResource LxCardTitleStyle}"
                            Text="外观" />

                        <Border Style="{StaticResource LxSettingRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LxSettingLabelStyle}" Text="主题" />
                                <Border
                                    Grid.Column="1"
                                    Style="{StaticResource LxSegmentHostStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="1">
                                        <ToggleButton
                                            Click="OnThemeSystemClick"
                                            Content="跟随系统"
                                            IsChecked="{x:Bind ViewModel.IsThemeSystem, Mode=OneWay}"
                                            Style="{StaticResource LxSegmentToggleStyle}" />
                                        <ToggleButton
                                            Click="OnThemeLightClick"
                                            Content="浅色"
                                            IsChecked="{x:Bind ViewModel.IsThemeLight, Mode=OneWay}"
                                            Style="{StaticResource LxSegmentToggleStyle}" />
                                        <ToggleButton
                                            Click="OnThemeDarkClick"
                                            Content="深色"
                                            IsChecked="{x:Bind ViewModel.IsThemeDark, Mode=OneWay}"
                                            Style="{StaticResource LxSegmentToggleStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource LxSettingRowLastStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LxSettingLabelStyle}" Text="窗口材质" />
                                <ComboBox
                                    Height="28"
                                    Grid.Column="1"
                                    Width="124"
                                    FontSize="{StaticResource LxFontCaption}"
                                    SelectedIndex="{x:Bind ViewModel.BackdropIndex, Mode=TwoWay}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.BackdropHint, Mode=OneWay}">
                                    <ComboBoxItem Content="Mica（推荐）" />
                                    <ComboBoxItem Content="Mica Alt" />
                                    <ComboBoxItem Content="亚克力" />
                                    <ComboBoxItem Content="纯色" />
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── 2 通用 ──────────────────────────────────────────── -->
                <Border
                    Grid.Column="1"
                    Padding="12,9"
                    Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,1"
                            Style="{StaticResource LxCardTitleStyle}"
                            Text="通用" />

                        <Border Style="{StaticResource LxSettingRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LxSettingLabelStyle}" Text="关闭时最小化到托盘" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}"
                                    OnContent=""
                                    OffContent=""
                                />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource LxSettingRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LxSettingLabelStyle}" Text="窗口列表自动刷新周期" />
                                <ComboBox
                                    Height="28"
                                    Grid.Column="1"
                                    Width="124"
                                    FontSize="{StaticResource LxFontCaption}"
                                    SelectedIndex="{x:Bind ViewModel.RefreshPeriodIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="1 秒" />
                                    <ComboBoxItem Content="2 秒" />
                                    <ComboBoxItem Content="5 秒" />
                                    <ComboBoxItem Content="10 秒" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource LxSettingRowLastStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource LxSettingLabelStyle}"
                                    Text="单实例保护（二次启动唤醒已有窗口）"
                                    TextTrimming="CharacterEllipsis" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    IsEnabled="False"
                                    IsOn="True"
                                    ToolTipService.ToolTip="常开能力：第二个实例会唤醒已有窗口后退出，不提供关闭开关"
                                    OnContent=""
                                    OffContent=""
                                />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── 3 热键与提示音 ──────────────────────────────────── -->
                <Border
                    Grid.Row="1"
                    Padding="12,9"
                    Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,1"
                            Style="{StaticResource LxCardTitleStyle}"
                            Text="热键与提示音" />

                        <Border Style="{StaticResource LxSettingRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LxSettingLabelStyle}" Text="全局启停热键" />
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Button
                                        x:Name="HotKeyButton"
                                        Width="132"
                                        Padding="8,4"
                                        Click="OnHotKeyButtonClick"
                                        Command="{x:Bind ViewModel.BeginCaptureHotKeyCommand}"
                                        KeyDown="OnHotKeyCaptureKeyDown"
                                        Style="{StaticResource LxSecondaryButtonStyle}"
                                        ToolTipService.ToolTip="点击后按下新的组合键，Esc 取消">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11.5"
                                                Text="{x:Bind ViewModel.HotKeyButtonText, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <FontIcon
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Glyph="&#xE765;" />
                                        </Grid>
                                    </Button>
                                    <Button
                                        VerticalAlignment="Center"
                                        Command="{x:Bind ViewModel.CancelCaptureHotKeyCommand}"
                                        Content="取消"
                                        Style="{StaticResource LxLinkButtonStyle}"
                                        Visibility="{x:Bind ViewModel.IsCapturing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource LxSettingRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LxSettingLabelStyle}" Text="启停提示音" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    IsOn="{x:Bind ViewModel.PlayToggleSound, Mode=TwoWay}"
                                    OnContent=""
                                    OffContent=""
                                />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource LxSettingRowStyle}">
                            <TextBlock
                                Style="{StaticResource LxMetaTextStyle}"
                                Text="热键注册失败时自动回退为窗口内快捷键" />
                        </Border>

                        <Border Style="{StaticResource LxSettingRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LxSettingLabelStyle}" Text="提示音音效" />
                                <ComboBox
                                    Height="28"
                                    Grid.Column="1"
                                    Width="124"
                                    FontSize="{StaticResource LxFontCaption}"
                                    ItemsSource="{x:Bind ViewModel.SoundStyleOptions}"
                                    SelectedIndex="{x:Bind ViewModel.SoundStyleIndex, Mode=OneWay}"
                                    ToolTipService.ToolTip="应用内只内置了上扬 / 下沉一对音效，无其他方案可选" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource LxSettingRowLastStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LxSettingLabelStyle}" Text="试听" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button
                                        Command="{x:Bind ViewModel.PlayRisingCommand}"
                                        Content="播放上扬"
                                        Style="{StaticResource LxLinkButtonStyle}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{ThemeResource LxTextTertiaryBrush}"
                                        Text="/" />
                                    <Button
                                        Command="{x:Bind ViewModel.PlayFallingCommand}"
                                        Content="播放下沉"
                                        Style="{StaticResource LxLinkButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── 4 关于与维护 ────────────────────────────────────── -->
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Padding="12,9"
                    Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,1"
                            Style="{StaticResource LxCardTitleStyle}"
                            Text="关于与维护" />

                        <Border Style="{StaticResource LxSettingRowStyle}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LxSettingLabelStyle}" Text="数据目录" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource LxSettingValueStyle}"
                                    Text="{x:Bind ViewModel.DataDirectory, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.DataDirectory, Mode=OneWay}" />
                                <Button
                                    Grid.Column="2"
                                    Padding="5,2"
                                    Command="{x:Bind ViewModel.OpenDataDirectoryCommand}"
                                    Style="{StaticResource LxSecondaryButtonStyle}"
                                    ToolTipService.ToolTip="在资源管理器中打开">
                                    <FontIcon FontSize="11" Glyph="&#xE8A7;" />
                                </Button>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource LxSettingRowStyle}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LxSettingLabelStyle}" Text="同步核心版本" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource LxSettingValueStyle}"
                                    Text="{x:Bind ViewModel.CoreDllText}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource LxSettingRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource LxSettingLabelStyle}"
                                    Text="管理员权限"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.PrivilegeText, Mode=OneWay}" />
                                <Button
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.RestartAsAdminCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsElevated, Mode=OneWay, Converter={StaticResource InverseBool}}"
                                    Style="{StaticResource LxSecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon
                                            FontSize="11"
                                            Foreground="{ThemeResource LxWarningBrush}"
                                            Glyph="&#xE7EF;" />
                                        <TextBlock FontSize="11.5" Text="以管理员重启" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource LxSettingRowLastStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LxSettingLabelStyle}" Text="运行日志与崩溃日志" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button
                                        Command="{x:Bind ViewModel.OpenDataDirectoryCommand}"
                                        Content="打开目录"
                                        Style="{StaticResource LxLinkButtonStyle}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{ThemeResource LxTextTertiaryBrush}"
                                        Text="·" />
                                    <Button
                                        Command="{x:Bind ViewModel.ExportDiagnosticsCommand}"
                                        Content="导出诊断包"
                                        Style="{StaticResource LxLinkButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── 5 同步细节 ──────────────────────────────────────── -->
                <Border
                    Grid.Row="2"
                    Padding="12,9"
                    Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,1"
                            Style="{StaticResource LxCardTitleStyle}"
                            Text="同步细节" />

                        <Border Style="{StaticResource LxSettingRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource LxSettingLabelStyle}"
                                    Text="光标看守（补投抬起消息）"
                                    TextTrimming="CharacterEllipsis" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    IsEnabled="False"
                                    IsOn="True"
                                    ToolTipService.ToolTip="常开能力：移出主窗口时补投一次抬起，避免从窗口卡在按住状态"
                                    OnContent=""
                                    OffContent=""
                                />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource LxSettingRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource LxSettingLabelStyle}"
                                    Text="悬停同步（移入即开始）"
                                    TextTrimming="CharacterEllipsis" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    IsOn="{x:Bind ViewModel.HoverSyncEnabled, Mode=TwoWay}"
                                    OnContent=""
                                    OffContent=""
                                />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource LxSettingRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LxSettingLabelStyle}" Text="文本镜像 diff 周期" />
                                <ComboBox
                                    Height="28"
                                    Grid.Column="1"
                                    Width="124"
                                    FontSize="{StaticResource LxFontCaption}"
                                    ItemsSource="{x:Bind ViewModel.TextMirrorIntervalOptions}"
                                    SelectedIndex="{x:Bind ViewModel.TextMirrorIntervalIndex, Mode=OneWay}"
                                    ToolTipService.ToolTip="由同步核心固定，界面只读展示" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource LxSettingRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LxSettingLabelStyle}" Text="剪贴板注入上限" />
                                <ComboBox
                                    Height="28"
                                    Grid.Column="1"
                                    Width="124"
                                    FontSize="{StaticResource LxFontCaption}"
                                    ItemsSource="{x:Bind ViewModel.ClipboardLimitOptions}"
                                    SelectedIndex="{x:Bind ViewModel.ClipboardLimitIndex, Mode=OneWay}"
                                    ToolTipService.ToolTip="单次注入的字符上限，由同步核心固定" />
                            </Grid>
                        </Border>

                        <!--
                            文本注入有两条能力完全不同的通道，用户有权知道现在走的是哪一条：
                            标准输入框不需要抢前台，自绘控件和游戏只能靠切前台 + 模拟输入。
                            把话说在前面，比事后解释「为什么我的窗口闪了一下」要好。
                        -->
                        <Border Style="{StaticResource LxSettingRowLastStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource LxSettingLabelStyle}" Text="文本注入通道" />
                                <TextBlock
                                    FontSize="{StaticResource LxFontCaption}"
                                    Foreground="{ThemeResource LxTextTertiaryBrush}"
                                    TextWrapping="Wrap"
                                    Text="标准输入框（Edit / RichEdit / WinForms / Scintilla）走无焦点通道：直接投字符消息，不切换前台。自绘控件、WPF、Electron 与游戏没有这条路，只能短暂切换到从窗口用模拟输入，注入完自动把前台还回去。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── 6 诊断与日志 ────────────────────────────────────── -->
                <Border
                    Grid.Row="2"
                    Grid.Column="1"
                    Padding="12,9"
                    Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,1"
                            Style="{StaticResource LxCardTitleStyle}"
                            Text="诊断与日志" />

                        <Border Style="{StaticResource LxSettingRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LxSettingLabelStyle}" Text="日志级别" />
                                <ComboBox
                                    Height="28"
                                    Grid.Column="1"
                                    Width="124"
                                    FontSize="{StaticResource LxFontCaption}"
                                    ItemsSource="{x:Bind ViewModel.LogLevelOptions}"
                                    SelectedIndex="{x:Bind ViewModel.LogLevelIndex, Mode=OneWay}"
                                    ToolTipService.ToolTip="当前版本记录全部级别，未做级别过滤" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource LxSettingRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LxSettingLabelStyle}" Text="日志环形缓冲上限" />
                                <ComboBox
                                    Height="28"
                                    Grid.Column="1"
                                    Width="124"
                                    FontSize="{StaticResource LxFontCaption}"
                                    ItemsSource="{x:Bind ViewModel.LogRingOptions}"
                                    SelectedIndex="{x:Bind ViewModel.LogRingIndex, Mode=OneWay}"
                                    ToolTipService.ToolTip="缓冲上限编译期固定为 300 条" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource LxSettingRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LxSettingLabelStyle}" Text="崩溃日志落盘" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    IsEnabled="False"
                                    IsOn="True"
                                    ToolTipService.ToolTip="常开能力：未捕获异常写入 %TEMP%\LeXiangSync.crash.log"
                                    OnContent=""
                                    OffContent=""
                                />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource LxSettingRowLastStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LxSettingLabelStyle}" Text="导出诊断包" />
                                <Button
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.ExportDiagnosticsCommand}"
                                    Style="{StaticResource LxSecondaryButtonStyle}"
                                    ToolTipService.ToolTip="把数据目录打包成 ZIP 存到桌面并定位到文件">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontSize="11" Glyph="&#xE896;" />
                                        <TextBlock FontSize="11.5" Text="导出 ZIP" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- ══ 底部通栏条 ══════════════════════════════════════════════════ -->
        <Border
            Grid.Row="2"
            Style="{StaticResource LxBottomBarStyle}">
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">
                <Grid MinWidth="780" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ToggleButton
                            Content="鼠标"
                            IsChecked="{x:Bind Main.Engine.SyncMouse, Mode=TwoWay}"
                            Style="{StaticResource LxSyncChipToggleStyle}" />
                        <ToggleButton
                            Content="键盘"
                            IsChecked="{x:Bind Main.Engine.SyncKeyboard, Mode=TwoWay}"
                            Style="{StaticResource LxSyncChipToggleStyle}" />
                        <ToggleButton
                            Content="剪贴板"
                            IsChecked="{x:Bind Main.Engine.SyncClipboard, Mode=TwoWay}"
                            Style="{StaticResource LxSyncChipToggleStyle}" />
                        <ToggleButton
                            Content="文本镜像"
                            IsChecked="{x:Bind Main.TextMirror, Mode=TwoWay}"
                            Style="{StaticResource LxSyncChipToggleStyle}"
                            ToolTipService.ToolTip="文本镜像：同步中文输入与粘贴内容。读主窗口输入框文本做 diff，再用 WM_CHAR 投递给从窗口" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            Command="{x:Bind Main.ToggleSyncCommand}"
                            Style="{StaticResource LxPrimaryButtonStyle}"
                            ToolTipService.ToolTip="快捷键 Ctrl + Alt + S">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="10" Glyph="&#xE71A;" />
                                <TextBlock FontSize="11.5" Text="{x:Bind Main.ToggleButtonText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>

                        <ToggleButton
                            IsChecked="{x:Bind Main.LogExpanded, Mode=TwoWay}"
                            Style="{StaticResource LxToggleChipStyle}"
                            ToolTipService.ToolTip="展开 / 收起运行日志">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="11" Glyph="&#xE8A9;" />
                                <TextBlock FontSize="11.5" Text="{x:Bind Main.LogCountText, Mode=OneWay}" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
